{
  "name": "@flash-sale/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Code shared by more than one backend app: types, message formats, key names, clients, config helpers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./config": "./src/config.ts",
    "./errors": "./src/errors.ts",
    "./lifecycle": "./src/lifecycle.ts",
    "./logger": "./src/logger.ts",
    "./order": "./src/order.ts",
    "./order-publisher": "./src/order-publisher.ts",
    "./postgres": "./src/postgres/index.ts",
    "./rabbitmq": "./src/rabbitmq.ts",
    "./redis-client": "./src/redis-client.ts",
    "./redis-keys": "./src/redis-keys.ts",
    "./sale": "./src/sale.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
